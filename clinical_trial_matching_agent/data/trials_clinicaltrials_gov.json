    "title": "Phase III Study of Dapagliflozin in Type 2 Diabetes Mellitus With Early Stage CKD",
    "TherapeuticArea": "Endocrinology / Nephrology",
    "phase": "Phase 3",
    "status": "Recruiting",
    "sponsor": "AstraZeneca / Clinical Research Network",
